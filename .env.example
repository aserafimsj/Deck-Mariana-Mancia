# Copie para .env.local e preencha.

# --- Supabase (Painel > Project Settings > API Keys) ---
# Públicas: vão para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta: só no servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Banco (Painel > Connect > Transaction pooler, porta 6543) ---
# O servidor do jogo fala direto com o Postgres por esta URL.
SUPABASE_DB_URL=postgres://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Opcional, recomendado: certificado do Supabase (Database Settings > SSL) para verificar a conexão.
# SUPABASE_DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Só desenvolvimento local, sem Supabase ---
# Banco local: pnpm db:local e depois node scripts/db-setup.mjs (imprime a URL).
# SUPABASE_DB_URL=postgres://postgres@localhost:54329/scragbadum_dev
# Login local de teste (desligado na produção da Vercel):
# DEV_AUTH_SECRET=um-segredo-qualquer-com-16-ou-mais
# NEXT_PUBLIC_DEV_AUTH=1

# Testes de banco
DATABASE_URL=postgres://postgres@localhost:54329/postgres
