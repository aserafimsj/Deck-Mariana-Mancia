# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API Keys).

# Públicas: vão para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secreta: só no servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Só para os testes de banco locais (pnpm db:local mostra a URL).
DATABASE_URL=postgres://postgres@localhost:54329/postgres
